# === Core ===
APP_ENV=development
DATABASE_URL=sqlite:///./data/tn_news.db
# Production: postgresql://user:pass@postgres:5432/tn_news

TIMEZONE=Asia/Kolkata
PUBLISH_MODE=review
# review | auto
RUN_MODE=test
# test | production

# === Dashboard auth ===
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-strong-password
DASHBOARD_SECRET=change-me-session-secret

# === Scoring ===
MIN_STORY_CONFIDENCE=0.55
MAX_STORIES_PER_DAY=2

# === Budget (USD estimates) ===
DAILY_BUDGET_USD=15.0
MONTHLY_BUDGET_USD=300.0

# === News providers (optional) ===
NEWSAPI_KEY=
NEWSDATA_API_KEY=

# === YouTube Data API v3 ===
YOUTUBE_CLIENT_SECRETS_FILE=./data/secrets/client_secrets.json
YOUTUBE_TOKEN_FILE=./data/secrets/youtube_token.json
YOUTUBE_API_KEY=
# API key used for read-only search/trend signals (not upload)

# === LLM (optional — falls back to rule-based script in test mode) ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SCRIPT_PROVIDER=auto
# auto | openai | rules

# === TTS ===
TTS_PROVIDER=edge
# edge | elevenlabs | openai
EDGE_TTS_VOICE=ta-IN-PallaviNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# === Image generation (optional) ===
IMAGE_PROVIDER=pillow
# pillow | openai
OPENAI_IMAGE_MODEL=dall-e-3

# === Notifications ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Branding paths ===
CHANNEL_LOGO_PATH=./assets/branding/logo.png
INTRO_VIDEO_PATH=./assets/branding/intro.mp4
OUTRO_VIDEO_PATH=./assets/branding/outro.mp4
BACKGROUND_MUSIC_PATH=./assets/audio/background.mp3
