# Channel: sign in as toptrend71@gmail.com during youtube-auth
# Copy to .env on your server after filling secrets.

OPERATION_PHASE=4
# When laptop turns on: start app → makes videos + uploads (once per day).
RUN_TRIGGER=on_startup
SCHEDULER_ENABLED=false
SKIP_IF_RAN_TODAY=true
TIMEZONE=Asia/Kolkata

RUN_MODE=production
PUBLISH_MODE=auto

DATABASE_URL=sqlite:///./data/tn_news.db

YOUTUBE_EXPECTED_EMAIL=toptrend71@gmail.com
# Optional: paste channel ID for a Brand Account channel
# YOUTUBE_EXPECTED_CHANNEL_ID=
# YOUTUBE_PLAYLIST_ID=

DAILY_BUDGET_USD=15.0
MONTHLY_BUDGET_USD=300.0

NOTIFY_EMAIL_TO=toptrend71@gmail.com
# Configure SMTP_* to receive daily run summaries
