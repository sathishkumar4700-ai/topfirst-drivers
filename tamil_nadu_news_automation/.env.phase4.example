# Copy to .env when graduating from Phase 1 pilot to Phase 4 daily automation.
# See docs/PHASES.md

OPERATION_PHASE=4
SCHEDULER_ENABLED=true
TIMEZONE=Asia/Kolkata

RUN_MODE=production
PUBLISH_MODE=auto

DATABASE_URL=postgresql://tnnews:tnnews@postgres:5432/tn_news

DAILY_BUDGET_USD=15.0
MONTHLY_BUDGET_USD=300.0

# Strongly recommended for unattended runs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Or SMTP_* + NOTIFY_EMAIL_TO

NEWSAPI_KEY=
YOUTUBE_API_KEY=
# YouTube upload: data/secrets/client_secrets.json + python -m app.cli youtube-auth
